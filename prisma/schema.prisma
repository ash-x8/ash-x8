// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default("1")
  siteName        String   @default("Creative Studio")
  tagline         String   @default("Design. Develop. Create.")
  logo            String?
  favicon         String?
  email           String   @default("hello@example.com")
  phone           String?
  location        String?  @default("Remote / Worldwide")
  timezone        String?  @default("UTC")
  accentColor     String   @default("#3B82F6") // Hex color
  themeSettings   String?  @default("{\"borderRadius\": \"0.5rem\", \"animationIntensity\": \"medium\"}")
  analyticsId     String?
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model HeroSection {
  id               String   @id @default("1")
  heading          String   @default("Designing ideas.\nBuilding experiences.")
  subtitle         String   @default("Creative Developer & Digital Designer")
  description      String   @default("Creative developer, designer and digital creator building apps, websites, brands and digital content.")
  primaryCtaText   String   @default("Explore My Work")
  primaryCtaLink   String   @default("/work")
  secondaryCtaText String   @default("Let's Collaborate")
  secondaryCtaLink String   @default("/contact")
  statusBadge      String   @default("Available for selected projects")
  heroImage        String?
  heroVideo        String?
  smallText        String?  @default("DESIGN → DEVELOP → CREATE → MANAGE")
  visualElements   String?  // JSON string for configurable hero components
  updatedAt        DateTime @updatedAt
}

model AboutSection {
  id                String   @id @default("1")
  name              String   @default("Alex Morgan")
  title             String   @default("Creative Developer & Digital Designer")
  profileImage      String?
  shortBio          String   @default("Multidisciplinary digital creator working across design, development, and digital content creation.")
  longBio           String   @default("I combine strategic thinking, technical expertise, and artistic vision to deliver high-impact digital experiences. With extensive background across frontend, backend, UI/UX design, branding, and video editing, I build end-to-end digital solutions.")
  personalStatement String   @default("I work at the intersection of design, technology and digital content.")
  location          String?  @default("Worldwide")
  availability      String?  @default("Open for freelance & contract work")
  updatedAt         DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  shortDesc   String
  longDesc    String?
  icon        String?  // Lucide icon name or image path
  image       String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SkillCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  displayOrder Int      @default(0)
  skills       Skill[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  skillLevel   String?       // e.g., "Expert", "Advanced"
  description  String?
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  categoryId   String
  category     SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Project {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  shortDesc     String
  fullDesc      String
  category      String           // Apps, Web, UI/UX, Graphic Design, Branding, Social Media, Content
  year          String
  client        String?
  role          String?
  tools         String?          // JSON array or comma separated
  technologies  String?          // JSON array or comma separated
  coverImage    String?
  videoUrl      String?
  liveUrl       String?
  githubUrl     String?
  isFeatured    Boolean          @default(false)
  isPublished   Boolean          @default(true)
  displayOrder  Int              @default(0)

  // Case Study Sections
  overview      String?
  challenge     String?
  research      String?
  concept       String?
  design        String?
  development   String?
  testing       String?
  finalProduct  String?
  results       String?
  sectionsConfig String?         // JSON string defining enabled sections & order

  gallery       ProjectGallery[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProjectGallery {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String?
  displayOrder Int      @default(0)
}

model DesignItem {
  id           String   @id @default(uuid())
  title        String
  category     String   // Logo, Branding, Poster, Social Media, Typography, UI Design, Marketing
  description  String?
  imageUrl     String
  year         String?
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialContent {
  id           String   @id @default(uuid())
  title        String
  platform     String   // Instagram, Facebook, TikTok, YouTube, Other
  contentType  String   // Post, Reel, Video, Story, Thumbnail, Campaign, Banner
  description  String?
  mediaUrl     String?
  videoUrl     String?
  url          String?
  campaign     String?
  date         String?
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExperienceItem {
  id           String   @id @default(uuid())
  dateRange    String   // e.g. "2022 - Present"
  title        String
  company      String?
  description  String
  category     String?  // Development, Design, Leadership, Freelance
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(uuid())
  name         String
  role         String
  company      String?
  quote        String
  photoUrl     String?
  website      String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(uuid())
  senderName  String
  email       String
  projectType String   // App Development, Web Development, Graphic Design, UI/UX, Content Creation, Social Media, Other
  message     String
  status      String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt   DateTime @default(now())
}

model SocialLink {
  id           String   @id @default(uuid())
  platform     String   @unique // GitHub, LinkedIn, Instagram, Behance, Dribbble, YouTube, TikTok, X, Facebook, Email
  url          String
  icon         String?
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
}

model NavigationItem {
  id           String   @id @default(uuid())
  label        String
  href         String
  category     String?  // Main, Work, Footer
  displayOrder Int      @default(0)
  enabled      Boolean  @default(true)
}

model SeoSetting {
  id             String   @id @default(uuid())
  pagePath       String   @unique // "/", "/about", "/work", etc.
  metaTitle      String
  metaDescription String
  keywords       String?
  ogImage        String?
  noIndex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(uuid())
  filename   String
  filepath   String
  filetype   String
  filesize   Int
  dimensions String?
  altText    String?
  createdAt  DateTime @default(now())
}
